{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omni-context.local/schemas/requirements.schema.json",
  "title": "OmniContext Requirements Registry",
  "description": "Requirements grouped under named categories, each holding a flat array; the category name is the object key, and individual requirement objects carry no 'category' field. The required-key list mirrors REQUIRED_REQUIREMENT_KEYS in make_ai.py. Every list-shaped field is a JSON array, not a comma-separated string.",
  "type": "object",
  "required": [
    "version",
    "requirement_id_prefix",
    "categories"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "requirement_id_prefix": {
      "type": "string",
      "pattern": "^[A-Z]+$"
    },
    "categories": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/requirement"
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "requirement": {
      "type": "object",
      "required": [
        "id",
        "title",
        "description",
        "priority",
        "status",
        "minimum_access_scope",
        "acceptance_criteria",
        "validation_required",
        "documentation_required",
        "risk_notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]+-[0-9]{3}$"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          ]
        },
        "priority": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "status": {
          "enum": [
            "completed",
            "pending",
            "proposed",
            "blocked",
            "needs_review",
            "withdrawn"
          ]
        },
        "minimum_access_scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "do_not_access": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "validation_required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "documentation_required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "risk_notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    }
  }
}
