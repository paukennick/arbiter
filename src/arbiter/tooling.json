      "languages": ["python", "javascript", "typescript", "go", "java", "ruby", "terraform", "hcl", "yaml", "json"]
    },
    {
      "name": "bandit",
      "binary": "bandit",
      "version_args": ["--version"],
      "version": "1.9.4",
      "install_method": "pip",
      "install_package": "bandit",
      "languages": ["python"]
    },
    {
      "name": "ruff",
      "binary": "ruff",
      "version_args": ["--version"],
      "version": "0.15.11",
      "install_method": "pip",
      "install_package": "ruff",
      "languages": ["python"]
    },
    {
      "name": "gitleaks",
      "binary": "gitleaks",
      "version_args": ["version"],
      "version": "8.21.2",
